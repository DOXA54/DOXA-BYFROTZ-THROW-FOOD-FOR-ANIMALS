local toastLbl, toastTok = nil, 0
local function setStatus(t, color)
    if not TAMPILKAN_STATUS then return end
    if statusLbl and statusLbl.Parent then
        statusLbl.Text = t
        statusLbl.TextColor3 = color or C_GRAY
        return
